
# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads

# SageOx team context
.sageox/** linguist-language=SageOx
*.ox linguist-language=SageOx

# The skill catalog is embedded from the checkout at build time, and its
# frontmatter parser expects LF. Without this, git on Windows checks these out
# with CRLF and a Windows-built ox rejects its own catalog.
extensions/skills/**/*.md text eol=lf

# Normalize every text file to LF in the working tree, on every platform.
# Golden/fixture tests compare bytes, and a core.autocrlf=true checkout on
# Windows otherwise turns every LF fixture into CRLF and fails ~250 subtests.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.gif binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.db binary
*.sqlite binary
